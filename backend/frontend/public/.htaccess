<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories as-is
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing /assets/* or any file with an extension → real 404
  RewriteRule ^assets/ - [R=404,L]
  RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]+$
  RewriteRule ^ - [R=404,L]

  # Everything else → SPA entry point
  RewriteRule ^ /index.html [L]
</IfModule>

# Cache headers
<IfModule mod_headers.c>
  # HTML must revalidate so deploys are picked up immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Vite-fingerprinted assets are immutable
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|jpg|png|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
